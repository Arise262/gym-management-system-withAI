// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Identity + credentials + role. Every person who can log in has exactly one
/// User. Domain data still hangs off Member / Trainer, so existing member_id
/// foreign keys (Sales, Attendance, FitnessRecord) are untouched.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(MEMBER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  member       Member?
  trainer      Trainer?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notifications Notification[]
  conversations ConversationParticipant[]
  sentMessages  Message[]

  @@index([role])
}

enum Role {
  ADMIN
  TRAINER
  MEMBER
}

model Member {
  id         String          @id @default(uuid())
  name       String
  email      String?
  memberCode String          @unique
  phone      BigInt
  address    String?
  DOB        String
  reviewDone Boolean         @default(false)
  gender     Gender
  DOJ        String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  sales      Sales[]
  attendance Attendance[]
  fitness    FitnessRecord[]
  // diets      DietChart[]

  /// Nullable so the Phase 1 migration can run before the backfill script
  /// links each existing member to a User. Backfill then makes it universal.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ── AI profiling inputs (Phase 2) ────────────────────────────────────────
  // All optional: existing members predate the profile form, and a member can
  // use the gym without ever filling it in. The workout planner treats a null
  // profile as "not enough information to generate a plan" rather than guessing.
  fitnessGoal        FitnessGoal?
  experienceLevel    ExperienceLevel?
  bodyType           BodyType?
  activityLevel      ActivityLevel?
  workoutDaysPerWeek Int?
  availableEquipment String[]
  injuries           String?
  medicalNotes       String?
  heightCm           Int?
  targetWeightKg     Int?

  workoutPlans    WorkoutPlan[]
  workoutSessions WorkoutSession[]
  bookings        Booking[]
  payments        Payment[]
  retentionScores RetentionScore[]
  engagement      EngagementMetric[]
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  ENDURANCE
  STRENGTH
  GENERAL_FITNESS
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum BodyType {
  ECTOMORPH
  MESOMORPH
  ENDOMORPH
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

model Services {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Int
  duration    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sales       Sales[]
}

model Sales {
  id          String    @id @default(uuid())
  member_id   String
  service_id  String
  service     Services  @relation(fields: [service_id], references: [id])
  description String?
  discount    Int
  amount      Int
  paid        Int
  startDate   String
  endDate     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  member      Member    @relation(fields: [member_id], references: [id])
  payments    Payment[]
}

model Attendance {
  id        String   @id @default(uuid())
  member_id String
  member    Member   @relation(fields: [member_id], references: [id])
  date      String
  time      String   @default("00:00:00")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FitnessRecord {
  id          String   @id @default(uuid())
  member_id   String
  member      Member   @relation(fields: [member_id], references: [id])
  date        String
  weight      Int
  height      Int
  chest       Int?
  abs         Int?
  hips        Int?
  thighs      Int?
  treadmill   Int?
  chestPress  Int?
  latPulldown Int?
  squats      Int?
  sitAndReach Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Enquiry {
  id           String      @id @default(uuid())
  name         String
  phone        BigInt
  followupDate String?
  message      String?
  type         EnquiryType
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum EnquiryType {
  call
  walkin
  instagram
  whatsapp
}

model ToDo {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Gender {
  male
  female
  other
}

