# ─────────────────────────────────────────────────────────────
# DATABASE — Supabase Postgres (https://supabase.com, free tier)
# Dashboard -> Connect. Two DIFFERENT tabs:
#   DATABASE_URL = "Transaction pooler" (port 6543), add ?pgbouncer=true
#   DIRECT_URL   = "Session pooler"     (port 5432)
#
# Do NOT use db.<ref>.supabase.co:5432 for DIRECT_URL. It is IPv6-only on new
# projects, so `npm run db:push` fails on an IPv4 network with an opaque error.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase API keys — unused until Phase 7 (Realtime chat) / Phase 10 (Storage).
# The publishable key is meant to be browser-visible and is not a secret.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ─────────────────────────────────────────────────────────────
# AUTH — Auth.js v5
# Generate AUTH_SECRET with:  npx auth secret
# AUTH_URL is intentionally NOT set - trustHost:true in auth.config.ts
# derives the origin from the request, so any port and any deploy host works.
# ─────────────────────────────────────────────────────────────
AUTH_SECRET=""

# Seed credentials for the first admin account (used by prisma/seed.ts).
# Change these before seeding anything you will demo.
SEED_ADMIN_EMAIL="admin@cbgfitness.local"
SEED_ADMIN_PASSWORD="ChangeMe@12345"

# ─────────────────────────────────────────────────────────────
# AI — Claude API (https://console.anthropic.com)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─────────────────────────────────────────────────────────────
# PAYMENTS — PayMongo TEST mode (https://dashboard.paymongo.com)
# Test keys work without business registration.
# ─────────────────────────────────────────────────────────────
PAYMONGO_SECRET_KEY="sk_test_"
PAYMONGO_PUBLIC_KEY="pk_test_"
PAYMONGO_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────
# EMAIL — Brevo transactional API (https://app.brevo.com, free 300/day)
# API key: Settings → SMTP & API → API Keys → Generate a new API key.
# MAIL_FROM must be a sender you have verified in Brevo (Senders & IP →
# Senders); an unverified address is rejected with a 400. Addresses on
# .local/.test domains are never emailed — see src/lib/mail.ts.
# Leave BREVO_API_KEY empty and notifications stay in-app only.
# ─────────────────────────────────────────────────────────────
BREVO_API_KEY=""
MAIL_FROM="CBG Fitness Center <you@example.com>"

# Public origin used in email links. Optional: on Vercel it is derived from
# VERCEL_PROJECT_PRODUCTION_URL; locally it falls back to http://localhost:3000.
APP_URL=""

# ─────────────────────────────────────────────────────────────
# CRON — shared secret guarding /api/cron/daily
# Generate with:  openssl rand -hex 32
# cron-job.org: create a job for GET https://<host>/api/cron/daily, daily at
# 07:00 Asia/Manila, with the header  Authorization: Bearer <CRON_SECRET>
# ─────────────────────────────────────────────────────────────
CRON_SECRET=""
